# Protects the whole app (REQUIRED on Railway)
APP_USER=admin
APP_PASSWORD=change-me

# Public URL of the app (Railway domain). Locally: http://localhost:8000
BASE_URL=http://localhost:8000

# Google Cloud OAuth client (type: Web). Redirect URI = BASE_URL/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
YT_API_KEY=
YT_COOKIES_FILE=
YT_PROXY=
DATABASE_URL=            # Railway Postgres plugin sets this
DATA_DIR=data            # Railway: mount a volume at /data
UPLOAD_LEAD_HOURS=48
MAX_UPLOADS_PER_DAY=5
AUTOPILOT_INTERVAL_HOURS=6
