# Copy to .env for local development and uncomment what you need.
# Everything is commented out on purpose: hosting platforms (e.g. Railway) offer to import
# uncommented example values as real variables, which once put a weak password live.

# --- required on a server ---
# APP_PASSWORD=<choose-a-strong-password>      # initial dashboard password (user: admin)
# BASE_URL=https://your-app.example.com        # public URL; local: http://localhost:8000
# GOOGLE_CLIENT_ID=<from Google Cloud>         # OAuth client, type Web; redirect = BASE_URL/auth/callback
# GOOGLE_CLIENT_SECRET=<from Google Cloud>

# --- recommended ---
# ADMIN_EMAIL=owner@example.com                # Google account allowed to reset the password
# DATABASE_URL=postgres://...                  # Railway Postgres sets this
# DATA_DIR=/data                               # must be the mounted volume (absolute path)

# --- optional ---
# APP_USER=admin
# TOKEN_ENCRYPTION_KEY=<Fernet key>
# YT_API_KEY=
# YT_COOKIES_FILE=
# YT_PROXY=
# UPLOAD_LEAD_HOURS=48
# MAX_UPLOADS_PER_DAY=5
# AUTOPILOT_INTERVAL_HOURS=6
